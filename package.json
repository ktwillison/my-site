{
  "name": "my-site",
  "private": true,
  "description": "Front-end dependencies for katewillison.com. Run `npm run vendor` after changing versions to copy the browser builds into server/src/libraries.",
  "scripts": {
    "vendor": "node scripts/vendor.js",
    "check:es": "es-check es2017 \"server/src/assets/js/*.js\" \"server/src/libraries/**/*.js\"",
    "outdated": "npm outdated"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "crossfilter2": "1.5.4",
    "d3": "7.9.0",
    "d3-sankey": "0.12.3",
    "dc": "4.2.7",
    "gsap": "3.15.0",
    "jquery": "4.0.0",
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "es-check": "^9.8.1",
    "firebase-tools": "^15.34.2"
  },
  "overrides": {
    "dc": {
      "d3": "$d3"
    }
  }
}
